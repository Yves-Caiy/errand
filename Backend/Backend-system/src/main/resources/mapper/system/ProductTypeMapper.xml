<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.axin.system.mapper.ProductTypeMapper">

    <resultMap id="ProductTypeResult" type="com.axin.system.domain.ProductType">
        <id     column="id"             property="id"/>
        <result column="type_name"      property="typeName"/>
        <result column="type_desc"      property="typeDesc"/>
        <result column="icon_url"       property="iconUrl"/>
        <result column="is_manageable"  property="isManageable"/>
        <result column="is_enabled"     property="isEnabled"/>
        <result column="create_time"    property="createTime"/>
        <result column="update_time"    property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, type_name, type_desc, icon_url, is_manageable, is_enabled, create_time, update_time
    </sql>

    <select id="selectProductTypeById" parameterType="long" resultMap="ProductTypeResult">
        SELECT <include refid="Base_Column_List"/> FROM product_type WHERE id = #{id}
    </select>

    <select id="selectProductTypeByName" parameterType="string" resultMap="ProductTypeResult">
        SELECT <include refid="Base_Column_List"/> FROM product_type WHERE type_name = #{typeName}
    </select>

    <select id="selectProductTypeList" parameterType="com.axin.system.domain.ProductType" resultMap="ProductTypeResult">
        SELECT <include refid="Base_Column_List"/> FROM product_type
        <where>
            <if test="typeName != null and typeName != ''">
                AND type_name LIKE CONCAT('%', #{typeName}, '%')
            </if>
            <if test="isManageable != null">
                AND is_manageable = #{isManageable}
            </if>
            <if test="isEnabled != null">
                AND is_enabled = #{isEnabled}
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <insert id="insertProductType" parameterType="com.axin.system.domain.ProductType" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_type (type_name, type_desc, icon_url, is_manageable, is_enabled, create_time, update_time)
        VALUES (#{typeName}, #{typeDesc}, #{iconUrl}, #{isManageable}, #{isEnabled}, NOW(), NOW())
    </insert>

    <update id="updateProductType" parameterType="com.axin.system.domain.ProductType">
        UPDATE product_type
        <set>
            <if test="typeName != null">type_name = #{typeName},</if>
            <if test="typeDesc != null">type_desc = #{typeDesc},</if>
            <if test="iconUrl != null">icon_url = #{iconUrl},</if>
            <if test="isManageable != null">is_manageable = #{isManageable},</if>
            <if test="isEnabled != null">is_enabled = #{isEnabled},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteProductTypeByIds" parameterType="long">
        DELETE FROM product_type WHERE id IN
        <foreach collection="ids" item="id" index="index" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>

</mapper>

