<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.axin.system.mapper.OrderItemMapper">

    <resultMap id="OrderItemResult" type="com.axin.system.domain.OrderItem">
        <id     column="id"            property="id"/>
        <result column="order_id"      property="orderId"/>
        <result column="item_type"     property="itemType"/>
        <result column="package_id"    property="packageId"/>
        <result column="product_id"    property="productId"/>
        <result column="product_name"  property="productName"/>
        <result column="quantity"      property="quantity"/>
        <result column="unit_price"    property="unitPrice"/>
        <result column="subtotal"      property="subtotal"/>
        <result column="store_id"      property="storeId"/>
        <result column="create_time"   property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, order_id, item_type, package_id, product_id, product_name, quantity, unit_price, subtotal, store_id, create_time
    </sql>

    <select id="selectOrderItemListByOrderId" parameterType="long" resultMap="OrderItemResult">
        SELECT <include refid="Base_Column_List"/> FROM order_item WHERE order_id = #{orderId} ORDER BY id ASC
    </select>

    <insert id="insertOrderItem" parameterType="com.axin.system.domain.OrderItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_item (order_id, item_type, package_id, product_id, product_name, quantity, unit_price, subtotal, store_id, create_time)
        VALUES (#{orderId}, #{itemType}, #{packageId}, #{productId}, #{productName}, #{quantity}, #{unitPrice}, #{subtotal}, #{storeId}, NOW())
    </insert>

</mapper>
