.order-module {
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 0;
  background: transparent;
}

.header-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.main-tabs {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #F5F6F8;
  padding-bottom: 16rpx;
}

.tab-item {
  font-size: 30rpx;
  color: #999999;
  font-weight: 500;
  position: relative;
  padding-bottom: 8rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #1677FF;
  font-weight: 600;
  font-size: 32rpx;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -18rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #1677FF;
  border-radius: 3rpx;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 0;
}

.filter-chip {
  display: inline-flex;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #F5F6F8;
  color: #666666;
  font-size: 26rpx;
  transition: all 0.3s ease;
  border: 1rpx solid transparent;
}

.filter-chip.active {
  background: rgba(22, 119, 255, 0.1);
  color: #1677FF;
  border-color: rgba(22, 119, 255, 0.2);
  font-weight: 500;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
  border: none;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F6F8;
}

.order-id {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-id .label {
  font-size: 24rpx;
  color: #999999;
}

.order-id .value {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 600;
  font-family: monospace;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(22, 119, 255, 0.1);
  color: #1677FF;
  font-weight: 500;
}

.card-content {
  padding: 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #666666;
  flex: 1;
}

.info-value.dim {
  color: #999999;
  font-size: 24rpx;
}

.info-value.warning {
  color: #F53F3F;
}

.info-value.price {
  color: #FF9A2E;
  font-weight: 600;
}

.info-divider {
  height: 1rpx;
  background: #F5F6F8;
  margin: 20rpx 0;
}

.card-footer {
  padding: 24rpx;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #EEF0F3;
  position: relative;
}

.total-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-price .label {
  font-size: 26rpx;
  color: #666666;
}

.total-price .amount {
  font-size: 40rpx;
  color: #1A1A1A;
  font-weight: 700;
  font-family: 'DIN Alternate', sans-serif;
}

.take-btn {
  background: #1677FF;
  color: #fff;
  border: none;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.24);
  margin: 0;
  transition: all 0.15s ease;
  display: flex;
  justify-content: center;
  align-items: center;
}

.take-btn:active {
  background: #0958D9;
  transform: scale(0.96);
  box-shadow: none;
}

.load-more-container {
  padding: 30rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.load-more-btn {
  background: #fff;
  color: #1677FF;
  border: 2rpx solid #1677FF;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.15s ease;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.load-more-btn:active {
  background: #F0F6FF;
  transform: scale(0.96);
  box-shadow: none;
}

.load-more-text {
  font-size: 26rpx;
  color: #999999;
  padding: 20rpx;
}
