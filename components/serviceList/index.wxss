:host {
  --grid-item-content-background-color: transparent;
  --grid-item-content-padding: 0;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%; /* Ensure it fills the grid item */
  min-height: 160rpx; /* Give it some height */
  padding: 20rpx 0;
  background: #F0F6FF;
  border-radius: 24rpx;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.grid-item-hover {
  background: #E2EDFF;
  transform: scale(0.95);
}

.grid-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.grid-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
  text-align: center;
  letter-spacing: 1rpx;
}
