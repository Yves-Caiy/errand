<wxs src="../../utils/i18n.wxs" module="i18n" />
<app-header title="{{i18n.t(locale,'我的订单')}}" showBack="{{false}}"></app-header>

<view class="orders-container">
  <van-tabs
    active="{{activeStatus}}"
    color="#1677FF"
    title-active-color="#1677FF"
    title-inactive-color="#666"
    line-width="24"
    bind:change="onTabsChange"
  >
    <van-tab title="{{i18n.t(locale,'全部')}}" name="all" />
    <van-tab title="{{i18n.t(locale,'待支付')}}" name="0" />
    <van-tab title="{{i18n.t(locale,'待接单')}}" name="1" />
    <van-tab title="{{i18n.t(locale,'已接单')}}" name="2" />
    <van-tab title="{{i18n.t(locale,'已完成')}}" name="3" />
    <van-tab title="{{i18n.t(locale,'已取消')}}" name="4" />
  </van-tabs>

  <view class="order-list">
    <block wx:for="{{displayOrders}}" wx:key="id">
      <view class="order-item">
        <!-- 头部：订单号 + 状态 -->
        <view class="card-header">
          <view class="order-id">
            <text class="label">{{i18n.t(locale,'订单号')}}</text>
            <text class="value">{{item.orderNo}}</text>
          </view>
          <view class="status-tag">{{i18n.t(locale, statusLabel[item.status])}}</view>
        </view>

        <!-- 内容区域 -->
        <view class="card-content">
          <!-- 服务类型 -->
          <view class="info-row">
            <text class="info-label">{{i18n.t(locale,'服务类型')}}</text>
            <text class="info-value" style="color: #1677FF; font-weight: 500;">{{i18n.t(locale, item.cardTag)}}</text>
          </view>

          <!-- 类型 1/2/3 显示 -->
          <block wx:if="{{item.orderType === 1 || item.orderType === 2 || item.orderType === 3}}">
            <view class="info-row" wx:if="{{item.runnerNickname}}">
              <text class="info-label">{{i18n.t(locale,'接单员')}}</text>
              <text class="info-value">{{item.runnerNickname}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">{{i18n.t(locale,'小区')}}</text>
              <text class="info-value">{{item.communityName}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">{{i18n.t(locale,'地址')}}</text>
              <text class="info-value">{{item.detailAddress}}</text>
            </view>
          </block>

          <!-- 类型 4 显示 -->
          <block wx:if="{{item.orderType === 4}}">
            <view class="info-row" wx:if="{{item.runnerNickname}}">
              <text class="info-label">{{i18n.t(locale,'接单员')}}</text>
              <text class="info-value">{{item.runnerNickname}}</text>
            </view>
            <view class="info-row">
              <text class="info-label">{{i18n.t(locale,'小区')}}</text>
              <text class="info-value">{{item.communityName}}</text>
            </view>
            <view class="info-row" wx:if="{{item.startAddress}}">
              <text class="info-label">{{i18n.t(locale,'起始地')}}</text>
              <text class="info-value">{{item.startAddress}}</text>
            </view>
            <view class="info-row" wx:if="{{item.endAddress}}">
              <text class="info-label">{{i18n.t(locale,'目的地')}}</text>
              <text class="info-value">{{item.endAddress}}</text>
            </view>
            <view class="info-row" wx:if="{{item.itemDesc}}">
              <text class="info-label">{{i18n.t(locale,'需求')}}</text>
              <text class="info-value">{{item.itemDesc}}</text>
            </view>
            <view class="info-row" wx:if="{{item.budget}}">
              <text class="info-label">{{i18n.t(locale,'预算')}}</text>
              <text class="info-value price">￥{{item.budget}}</text>
            </view>
            <view class="info-row" wx:if="{{item.specName}}">
              <text class="info-label">{{i18n.t(locale,'规格')}}</text>
              <text class="info-value">{{item.specName}}</text>
            </view>
            <view class="info-row" wx:if="{{item.wechatId}}">
              <text class="info-label">{{i18n.t(locale,'微信号')}}</text>
              <text class="info-value">{{item.wechatId}}</text>
            </view>
          </block>

          <!-- 分割线 -->
          <view class="info-divider"></view>
          
          <!-- 通用时间信息 -->
          <view class="info-row" wx:if="{{item.payTime}}">
            <text class="info-label">{{i18n.t(locale,'支付时间')}}</text>
            <text class="info-value dim">{{item.payTime}}</text>
          </view>
          <view class="info-row" wx:if="{{item.status === 3 && item.finishTime}}">
            <text class="info-label">{{i18n.t(locale,'完成时间')}}</text>
            <text class="info-value dim">{{item.finishTime}}</text>
          </view>
          <view class="info-row" wx:if="{{item.status === 4 && item.cancelReason}}">
            <text class="info-label">{{i18n.t(locale,'取消原因')}}</text>
            <text class="info-value warning">{{item.cancelReason}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">{{i18n.t(locale,'下单时间')}}</text>
            <text class="info-value dim">{{item.createTime}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">{{i18n.t(locale,'服务说明')}}</text>
            <text class="info-value dim">{{item.note || i18n.t(locale,'无')}}</text>
          </view>
        </view>

        <!-- 底部：价格与操作 -->
        <view class="card-footer">
          <view class="total-price">
            <text class="label">{{i18n.t(locale,'实付')}}</text>
            <text class="amount">￥{{item.actualAmount}}</text>
          </view>
          
          <view class="action-btn-group">
            <!-- 待支付状态 (0) 且 未支付 (0) 显示支付按钮 -->
            <button 
              wx:if="{{item.status === 0 && item.payStatus === 0}}" 
              class="action-btn outline-btn primary-btn" 
              size="mini" 
              bindtap="onPayOrder" 
              data-order-no="{{item.orderNo}}"
            >{{i18n.t(locale,'支付')}}</button>

            <!-- 待支付状态 (0) 且 未支付 (0) 显示取消订单 -->
            <button 
              wx:if="{{item.status === 0 && item.payStatus === 0}}" 
              class="action-btn outline-btn" 
              size="mini" 
              bindtap="onCancelOrder" 
              data-id="{{item.id}}"
              data-pay-status="{{item.payStatus}}"
            >{{i18n.t(locale,'取消订单')}}</button>
            
            <!-- 已接单(2) 显示 服务完成 -->
            <button 
              wx:if="{{item.status === 2}}" 
              class="action-btn primary-btn" 
              size="mini" 
              bindtap="onFinishOrder" 
              data-id="{{item.id}}"
            >{{i18n.t(locale,'服务完成')}}</button>

            <!-- 待接单(1)/已接单(2)/已完成(3) 且 已支付(1) 显示退款 -->
            <button 
              wx:if="{{(item.status === 1 || item.status === 2 || item.status === 3) && item.payStatus === 1}}" 
              class="action-btn outline-btn" 
              size="mini" 
              bindtap="onRefundOrder" 
              data-id="{{item.id}}"
              data-pay-status="{{item.payStatus}}"
            >{{i18n.t(locale,'退款')}}</button>

            <!-- 退款中 (2) -->
            <button 
              wx:if="{{item.payStatus === 2}}" 
              class="action-btn outline-btn" 
              size="mini" 
              disabled
              style="color: #FF9A2E; border-color: #FF9A2E;"
            >{{i18n.t(locale,'退款中')}}</button>

            <!-- 已退款 (3) -->
            <button 
              wx:if="{{item.payStatus === 3}}" 
              class="action-btn outline-btn" 
              size="mini" 
              disabled
              style="color: #999; border-color: #999;"
            >{{i18n.t(locale,'已退款')}}</button>
            
            <!-- 详情 (Type 1, 2, 3) -->
            <button 
              wx:if="{{item.orderType === 1 || item.orderType === 2 || item.orderType === 3}}" 
              class="action-btn outline-btn" 
              size="mini" 
              bindtap="onViewDetail" 
              data-id="{{item.id}}"
            >{{i18n.t(locale,'详情')}}</button>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="load-more-container" wx:if="{{displayOrders.length > 0}}">
    <view class="load-more-text" wx:if="{{loading}}">{{i18n.t(locale,'正在加载中...')}}</view>
    <view class="load-more-btn" wx:elif="{{hasMore}}" bindtap="onLoadMore">
      <text>{{i18n.t(locale,'点击加载更多')}}</text>
    </view>
    <view class="load-more-text" wx:else>{{i18n.t(locale,'没有更多订单了')}}</view>
  </view>

  <view class="bottom-space"></view>
</view>

<app-tabbar active="orders" bind:tabChange="onTabChange"></app-tabbar>
