.container {
  display: block;
  padding: 0;
  background-color: #F5F6F8;
  min-height: 100vh;
  box-sizing: border-box;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

/* 指派给我 */
.dispatch-block {
  background: #fff;
  margin-bottom: 24rpx;
  padding-bottom: 8rpx;
  border-top: 6rpx solid #1677FF;
}

.dispatch-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 24rpx 16rpx;
}

.dispatch-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1677FF;
}

.dispatch-text {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 600;
}

.dispatch-count {
  font-size: 22rpx;
  color: #fff;
  background: #1677FF;
  border-radius: 20rpx;
  padding: 2rpx 14rpx;
}

.dispatch-item {
  margin: 0 24rpx 16rpx;
  border: 1rpx solid #DCE7FA;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F7FAFF;
}

.dispatch-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx 0;
}

.dispatch-no {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 600;
  font-family: monospace;
}

.dispatch-countdown {
  font-size: 26rpx;
  color: #FF7A00;
  font-weight: 700;
  font-family: 'DIN Alternate', monospace;
}

.dispatch-body {
  padding: 16rpx 24rpx 0;
}

.ghost-btn {
  background: #fff !important;
  color: #666666 !important;
  border: 1rpx solid #DDDDDD !important;
}

.ghost-btn:active {
  opacity: 0.9;
}

.order-item {
  background: #fff;
  border-radius: 0;
  padding: 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
  border: none;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F6F8;
}

.order-id {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-id .label {
  font-size: 24rpx;
  color: #999999;
}

.order-id .value {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 600;
  font-family: monospace;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(22, 119, 255, 0.1);
  color: #1677FF;
  font-weight: 500;
}

.card-content {
  padding: 24rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #666666;
  flex: 1;
}

.info-value.dim {
  color: #999999;
  font-size: 24rpx;
}

.info-divider {
  height: 1rpx;
  background: #F5F6F8;
  margin: 20rpx 0;
}

.card-footer {
  padding: 24rpx;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #EEF0F3;
}

.total-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-price .label {
  font-size: 26rpx;
  color: #666666;
}

.total-price .amount {
  font-size: 40rpx;
  color: #1A1A1A;
  font-weight: 700;
  font-family: 'DIN Alternate', sans-serif;
}

.action-btn-group {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  margin: 0 !important;
  font-size: 26rpx !important;
  font-weight: 500;
  border-radius: 32rpx !important;
  padding: 0 32rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
}

.primary-btn {
  background: #1677FF !important;
  color: #fff !important;
  border: 1rpx solid #1677FF !important;
}

.primary-btn:active {
  opacity: 0.9;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}
