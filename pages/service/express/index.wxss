page {
  background: #F5F6F8;
  padding-bottom: 200rpx;
}

.container {
  display: block;
  padding: 12rpx;
  box-sizing: border-box;
}

.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.package-item {
  background: #F5F6F8; /* Slightly different bg to distinguish items inside card */
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E8EAEE;
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #D9DCE1; /* Slightly darker for contrast on gray bg */
}

.package-index {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.remove-btn {
  font-size: 24rpx;
  color: #F53F3F;
  padding: 6rpx 16rpx;
  background: #fff;
  border-radius: 8rpx;
  border: 1rpx solid #FDB2B2;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EEF0F3;
}

.form-row:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666666;
}

.input-field, .picker-field {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.picker-value.placeholder {
  color: #999999;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin-top: 10rpx;
  color: #1677FF;
  font-size: 28rpx;
  font-weight: 500;
  border-top: 1rpx dashed #D9DCE1;
}

.plus-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.form-col {
  display: flex;
  flex-direction: column;
  padding: 20rpx 0;
}

.textarea-field {
  width: 100%;
  height: 160rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

/* Tip Card */
.tip-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1677FF;
  margin-bottom: 12rpx;
}

.tip-content {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

.bottom-space {
  height: 250rpx;
}

/* Bottom Bar */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 24rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  /* justify-content: space-between; Removed to rely on absolute positioning */
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.price-section {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 4rpx;
}

.price-val {
  display: flex;
  align-items: baseline;
  color: #FF9A2E;
}

.currency {
  font-size: 28rpx;
  font-weight: 600;
}

.amount {
  font-size: 40rpx;
  font-weight: bold;
}

.submit-btn {
  position: absolute;
  right: 12rpx;
  top: 24rpx; /* Matches padding-top of bottom-bar */
  margin: 0 !important;
  width: auto !important;
  padding: 0 64rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #1677FF;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 16rpx rgba(22, 119, 255, 0.2);
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 8rpx rgba(22, 119, 255, 0.2);
}

/* Size Guide Card */
.size-guide-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.size-list {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
}

.size-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 19%;
}

.size-img {
  width: 100%;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  display: block;
}

.size-label {
  font-size: 22rpx;
  color: #666666;
  text-align: center;
}
