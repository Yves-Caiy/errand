<wxs src="../../../utils/i18n.wxs" module="i18n" />
<app-header title="{{i18n.t(locale,'物品寄存')}}" bindback="onBack"></app-header>

<view class="container">
  <!-- Main Form Card -->
  <view class="form-card">
    <view class="section-title">{{i18n.t(locale,'订单信息')}}</view>
    
    <!-- Address -->
    <view class="form-row">
      <text class="label">{{i18n.t(locale,'上门地址')}}</text>
      <input class="input-field" placeholder="{{i18n.t(locale,'请输入上门地址')}}" value="{{address}}" bindinput="onAddressInput" />
    </view>

    <!-- Storage Type (Spec) -->
    <view class="form-row">
      <text class="label">{{i18n.t(locale,'寄存类型')}}</text>
      <picker class="picker-field" mode="selector" range="{{productRange}}" value="{{specIndex}}" bindchange="onSpecChange">
        <view class="picker-value {{specIndex === null ? 'placeholder' : ''}}">
          {{specIndex !== null ? productRange[specIndex] : i18n.t(locale,'请选择寄存类型')}}
        </view>
      </picker>
    </view>

    <!-- Item Description -->
    <view class="form-row">
      <text class="label">{{i18n.t(locale,'寄存物品')}}</text>
      <input class="input-field" placeholder="{{i18n.t(locale,'请输入寄存物品')}}" value="{{itemDescription}}" bindinput="onItemInput" />
    </view>

    <!-- Appointment Time -->
    <view class="form-row">
      <text class="label">{{i18n.t(locale,'开始时间')}}</text>
      <picker mode="multiSelector" range="{{timeRange}}" bindchange="onStartTimeChange">
        <view class="picker-value {{!startTime ? 'placeholder' : ''}}">
          {{startTime || i18n.t(locale,'请选择上门时间')}}
        </view>
      </picker>
    </view>
    
    <view class="form-row">
      <text class="label">{{i18n.t(locale,'结束时间')}}</text>
      <picker mode="multiSelector" range="{{timeRange}}" bindchange="onEndTimeChange">
        <view class="picker-value {{!endTime ? 'placeholder' : ''}}">
          {{endTime || i18n.t(locale,'请选择上门时间')}}
        </view>
      </picker>
    </view>

    <!-- Remark -->
    <view class="form-col">
      <text class="label">{{i18n.t(locale,'备注')}}</text>
      <textarea class="textarea-field" placeholder="{{i18n.t(locale,'若有特殊物品，需提前备注')}}" value="{{remark}}" bindinput="onRemarkInput" />
    </view>
  </view>

  <!-- Tip Card -->
  <view class="tip-card">
    <view class="tip-title">{{i18n.t(locale,'服务提示')}}</view>
    <view class="tip-content">{{i18n.t(locale,'若价格与实际有偏差，可线下协调补差价。')}}</view>
  </view>

  <view class="bottom-space"></view>
</view>

<!-- Bottom Bar -->
<view class="bottom-bar">
  <view class="price-section">
    <text class="price-label">{{i18n.t(locale,'预估价格')}}</text>
    <view class="price-val">
      <text class="currency">¥</text>
      <text class="amount">{{totalPrice}}</text>
    </view>
  </view>
  <button class="submit-btn" bindtap="onSubmit">{{i18n.t(locale,'立即下单')}}</button>
</view>
