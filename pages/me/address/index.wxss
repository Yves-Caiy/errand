.container {
  display: block;
  padding: 20rpx 0;
  background-color: #F5F6F8;
  min-height: 100vh;
  box-sizing: border-box;
}

.form-group {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.label {
  font-size: 30rpx;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.picker-content {
  font-size: 28rpx;
  color: #1A1A1A;
  padding: 20rpx 0;
}

.picker-content.placeholder {
  color: #999;
}

.address-input {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.5;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.btn-area {
  margin-top: 60rpx;
  padding: 0 30rpx;
}

.save-btn {
  background: #1677FF;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-weight: bold;
}

.save-btn:active {
  opacity: 0.9;
}
