.swiper-wrapper {
  width: 100%;
  padding-top: 12rpx;
}

.swiper-card {
  margin: 0 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  height: 100%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transform: translateZ(0); /* Fix for border-radius on some devices */
}

.swiper {
  width: 100%;
  height: 100%;
}

.slide-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 24rpx;
}

/* 自定义指示点样式 */
.swiper .wx-swiper-dots {
  bottom: 20rpx;
}

.swiper .wx-swiper-dot {
  width: 12rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  transition: all 0.3s;
}

.swiper .wx-swiper-dot-active {
  width: 32rpx;
  height: 12rpx;
  background: #fff;
  border-radius: 6rpx;
}
