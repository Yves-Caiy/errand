.container {
  display: block;
  padding: 20rpx;
  background-color: #F5F6F8;
  min-height: 100vh;
  box-sizing: border-box;
}

.package-list {
  width: 100%;
}

.package-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.package-tag {
  position: absolute;
  top: 0;
  left: 0;
  background: #F53F3F;
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-bottom-right-radius: 16rpx;
  z-index: 1;
}

.package-content {
  padding: 30rpx;
  padding-top: 40rpx;
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.package-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.package-duration {
  font-size: 24rpx;
  color: #666;
  background-color: #F0F1F3;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.package-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 30rpx;
  min-height: 80rpx;
  background-color: #F5F6F8;
  padding: 20rpx;
  border-radius: 8rpx;
}

.package-footer {
  display: flex;
  align-items: flex-end;
  border-top: 1rpx solid #EEF0F3;
  padding-top: 20rpx;
  /* 预留按钮空间 */
  padding-right: 180rpx;
  min-height: 64rpx;
}

.price-box {
  display: flex;
  flex-direction: column;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.label {
  font-size: 20rpx;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  padding: 0 6rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.symbol {
  font-size: 24rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.current-price {
  font-size: 40rpx;
  color: #ff4d4f;
  font-weight: bold;
  margin-right: 10rpx;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.buy-btn {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  margin: 0;
  background: #1677FF;
  color: #fff;
  font-size: 28rpx;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  z-index: 2;
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.24);
  transition: all 0.15s ease;
}

.buy-btn:active {
  background: #0958D9;
  transform: scale(0.96);
  box-shadow: none;
}

.empty-state {
  text-align: center;
  padding-top: 100rpx;
  color: #999;
  font-size: 28rpx;
}
