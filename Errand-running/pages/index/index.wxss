/* 首页容器：顶部浅蓝渐变快速过渡到浅灰，突出“快”与内容本身 */
.page-wrap {
  padding: 24rpx 0 0;
  background: linear-gradient(180deg, #EAF2FF 0%, #F5F6F8 32%);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 公告栏：蓝色弱提示，扁平 */
.notice-bar {
  display: flex;
  align-items: center;
  background: #F0F6FF;
  padding: 16rpx 24rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
}

.notice-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notice-content {
  flex: 1;
  height: 40rpx;
  overflow: hidden;
  position: relative;
}

.notice-text {
  font-size: 26rpx;
  color: #1677FF;
  font-weight: 500;
  white-space: nowrap;
  position: absolute;
  top: 0;
  left: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  animation: scroll-left linear infinite;
}

@keyframes scroll-left {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-100%) translateX(-750rpx); /* Move far enough left */
  }
}

/* 服务与订单统一面板 */
.panel {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 8rpx 16rpx 16rpx;
  margin: 20rpx 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 26, 0.04);
}

/* 区块标题：清晰的信息层级 */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 8rpx 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: #1677FF;
  border-radius: 4rpx;
  margin-right: 12rpx;
  vertical-align: -2rpx;
}

.section-sub {
  font-size: 22rpx;
  color: #999999;
}

.panel-divider {
  height: 1rpx;
  background: #EEF0F3;
  margin: 8rpx 8rpx 0;
}
