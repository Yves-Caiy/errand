<wxs src="../../../utils/i18n.wxs" module="i18n" />
<app-header title="{{serviceName}}" bindback="onBack"></app-header>
<view class="container">
  <!-- 垃圾规格 -->
  <view class="form-card">
    <view class="section-title">{{i18n.t(locale,'垃圾信息')}} (共{{trashItems.length}}项)</view>
    
    <block wx:for="{{trashItems}}" wx:key="index">
      <view class="package-item">
        <view class="package-header">
          <text class="package-index">{{i18n.t(locale,'垃圾')}} #{{index + 1}}</text>
          <view class="remove-btn" wx:if="{{trashItems.length > 1}}" bindtap="removeTrashItem" data-index="{{index}}">{{i18n.t(locale,'删除')}}</view>
        </view>
        
        <view class="form-row">
          <text class="label">{{i18n.t(locale,'垃圾规格')}}</text>
          <picker 
            class="picker-field" 
            mode="selector" 
            range="{{productRange}}" 
            value="{{item.specIndex}}" 
            bindchange="onSpecChange" 
            data-index="{{index}}"
          >
            <view class="picker-value {{item.specIndex !== null ? '' : 'placeholder'}}">
              {{item.specIndex !== null ? productRange[item.specIndex] : i18n.t(locale,'请选择规格')}}
            </view>
          </picker>
        </view>
      </view>
    </block>
    
    <view class="add-btn" bindtap="addTrashItem">
      <text class="plus-icon">+</text> {{i18n.t(locale,'添加垃圾')}}
    </view>
  </view>

  <!-- Address, Time, Remark -->
  <view class="form-card">
    <view class="form-row">
      <text class="label">{{i18n.t(locale,'家庭住址')}}</text>
      <input 
        class="input-field" 
        placeholder="{{i18n.t(locale,'请输入家庭住址')}}" 
        value="{{address}}" 
        bindinput="onAddressInput"
      />
    </view>

    <view class="form-row">
      <text class="label">{{i18n.t(locale,'预约开始')}}</text>
      <picker 
        class="picker-field" 
        mode="multiSelector" 
        range="{{timeRange}}" 
        value="{{startTimeIndex}}" 
        bindchange="onStartTimeChange"
      >
        <view class="picker-value {{startTime ? '' : 'placeholder'}}">
          {{startTime || i18n.t(locale,'请选择开始时间')}}
        </view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">{{i18n.t(locale,'预约结束')}}</text>
      <picker 
        class="picker-field" 
        mode="multiSelector" 
        range="{{timeRange}}" 
        value="{{endTimeIndex}}" 
        bindchange="onEndTimeChange"
      >
        <view class="picker-value {{endTime ? '' : 'placeholder'}}">
          {{endTime || i18n.t(locale,'请选择结束时间')}}
        </view>
      </picker>
    </view>
    
    <view class="form-col">
      <text class="label">{{i18n.t(locale,'备注信息')}}</text>
      <textarea 
        class="textarea-field" 
        placeholder="{{i18n.t(locale,'需要备注的事项')}}" 
        value="{{remark}}" 
        bindinput="onRemarkInput"
      ></textarea>
    </view>
  </view>

  <!-- Tip Card -->
  <view class="tip-card">
    <view class="tip-title">{{i18n.t(locale,'服务说明')}}</view>
    <view class="tip-content">{{i18n.t(locale,'若垃圾重量过重或种类特殊，需线下自行协商价格。')}}</view>
  </view>

  <view class="bottom-space"></view>
</view>

<!-- Bottom Bar -->
<view class="bottom-bar">
  <view class="price-section">
    <text class="price-label">{{i18n.t(locale,'预估价格')}}</text>
    <view class="price-val">
      <text class="currency">￥</text>
      <text class="amount">{{totalPrice}}</text>
    </view>
  </view>
  <button class="submit-btn" bindtap="onSubmit">{{i18n.t(locale,'立即下单')}}</button>
</view>

